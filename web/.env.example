# Copia este archivo como .env.local (local) y configura las mismas variables en Vercel.

# Base de datos PostgreSQL (Neon desde Vercel → Storage, o Supabase → Connect → "Transaction pooler").
DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# Secreto para firmar la sesión del panel (mínimo 32 caracteres aleatorios).
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Usuarios del panel que crea `npm run db:setup` (cámbialos antes de producción).
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave
OPERADOR_EMAIL=operador@ejemplo.com
OPERADOR_PASSWORD=cambia-esta-clave

# Asistente de IA (Claude). Sin esta clave el chat muestra "asistente no disponible" y ofrece el formulario.
ANTHROPIC_API_KEY=
# Modelo del asistente. Haiku es el más económico; claude-opus-5-5 da respuestas más elaboradas a mayor costo.
CLAUDE_MODEL=claude-haiku-5-5

# Datos del negocio que usa el asistente
NEGOCIO_NOMBRE=Alquiler de Vehículos BP
NEGOCIO_LEMA=Todas las gamas
NEGOCIO_CIUDAD=Cali
NEGOCIO_WHATSAPP=+57 300 000 0000

# Opcional: tamaño del pool de conexiones (por defecto 5)
# DB_POOL_MAX=5

# WhatsApp Business (Cloud API de Meta) — ver README, sección WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Texto que tú inventas y repites en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=

# Servicios con conductor y alertas de la flota por WhatsApp: plantillas aprobadas en Meta (opcional cambiar los nombres).
# Sin plantilla aprobada, los mensajes solo llegan a quien le escribió al número del negocio en las últimas 24 horas.
# WHATSAPP_PLANTILLA_SERVICIO=servicio_conductor
# WHATSAPP_PLANTILLA_ALERTA=alerta_flota
# WHATSAPP_PLANTILLA_IDIOMA=es

# Opcional: clave para que un servicio externo llame una vez al día a /api/cron/alertas
# (cabecera Authorization: Bearer <clave>). Sin ella, las alertas se revisan cada vez que se abre el panel.
CRON_SECRET=
